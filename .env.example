# ==============================================================================
# SavageOps Environment Configuration
# Copy this file to .env and replace placeholders with your actual values.
# NEVER commit your real .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & LLM Settings (OpenAI / Compatible)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
MAX_DAILY_LLM_CALLS=500
MAX_DAILY_LLM_TOKENS=1000000

# ------------------------------------------------------------------------------
# 2. GitHub Integration (PRs, Code Fetching & Auto-Remediation)
# ------------------------------------------------------------------------------
# Personal Access Token with 'repo' scope
GITHUB_TOKEN=your_github_personal_access_token_here
# Target repository in format "owner/repo" (e.g., "my-org/my-service")
TARGET_REPO=owner/repo

# ------------------------------------------------------------------------------
# 3. Database & Authentication (Supabase / PostgreSQL)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
# Service Role Key (secret key used for server-side operations)
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
# Supabase JWT Secret for verifying user authentication tokens
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
# Direct PostgreSQL connection string (optional in dev, required in production)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 4. Security & Administration
# ------------------------------------------------------------------------------
# Secret token to authenticate incoming Grafana webhooks (Bearer token)
WEBHOOK_SECRET=replace-with-a-long-random-secret
# Bearer token required to scrape Prometheus /metrics endpoint
METRICS_TOKEN=replace-with-a-long-random-scrape-token
# Initial admin password for Grafana web UI (admin user)
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password
# Comma-separated admin emails authorized to approve solutions/PRs
ADMIN_EMAILS=admin@example.com
# Comma-separated admin user IDs from Supabase Auth
ADMIN_USER_IDS=user-uuid-1,user-uuid-2
# Environment mode: development | staging | production
APP_ENV=development

# ------------------------------------------------------------------------------
# 5. Grafana Integration & Sentinel Backup Poller
# ------------------------------------------------------------------------------
# URL of Grafana instance (use http://localhost:3000 locally, http://grafana:3000 inside Docker)
GRAFANA_URL=http://localhost:3000
# Grafana Service Account Token (Viewer role) for Sentinel background poller
GRAFANA_TOKEN=your_grafana_service_account_token_here
# Enable or disable background polling of Grafana alerts (true/false)
POLL_ENABLED=true
# Polling interval in seconds
POLL_INTERVAL_SECONDS=15

# ------------------------------------------------------------------------------
# 6. Loki Log Aggregation
# ------------------------------------------------------------------------------
# Direct Loki query endpoint (http://localhost:3100 locally, http://loki:3100 inside Docker)
LOKI_URL=http://localhost:3100
# Loki push URL for ingesting logs (used by simulation & log drivers)
LOKI_PUSH_URL=http://localhost:3100
# Loki datasource UID configured in Grafana
LOKI_DATASOURCE_UID=loki
# Default LogQL stream selector for fetching incident logs
LOG_SELECTOR='{service="$service"}'

# ------------------------------------------------------------------------------
# 7. Sentinel Incident Pipeline & Deduplication
# ------------------------------------------------------------------------------
# Deduplication window in minutes for identical alerts
DEBOUNCE_MINUTES=10
# Cooldown window in seconds before reprocessing the same alert group
GROUP_COOLDOWN_SECONDS=60
# Maximum concurrent incident pipelines running at once (semaphore limit)
MAX_CONCURRENT_INCIDENTS=3
# Maximum LangGraph reasoning hops before escalating to human
MAX_HOPS=12
# Maximum lines of diff in auto-generated pull requests
MAX_DIFF_LINES=200
# Optional JSON map linking service names to repository subdirectories (e.g., {"dummy-app": "src/"})
SERVICE_PATH_MAP={}

# ------------------------------------------------------------------------------
# 8. Notifications & Alerts (Optional)
# ------------------------------------------------------------------------------
# Optional Slack Incoming Webhook URL for incident notifications
SLACK_WEBHOOK_URL=
