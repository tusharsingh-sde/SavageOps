# Copy this file to .env and replace values as needed. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GITHUB_TOKEN=
TARGET_REPO=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
LOKI_URL=
WEBHOOK_SECRET=replace-with-a-long-random-value
ADMIN_EMAILS=
MAX_HOPS=8
MAX_DIFF_LINES=200

# Sentinel & Grafana / Loki configurations
GRAFANA_URL=http://localhost:3000
GRAFANA_TOKEN=
LOKI_DATASOURCE_UID=loki
LOKI_PUSH_URL=http://localhost:3100
LOG_SELECTOR='{service="$service"} |= "Error"'
POLL_ENABLED=true
POLL_INTERVAL_SECONDS=15
DEBOUNCE_MINUTES=10
MAX_CONCURRENT_INCIDENTS=3
SLACK_WEBHOOK_URL=
